# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/events_dashboard"

# Auth
AUTH_SECRET="your-random-secret-here"
AUTH_DOMAIN="localhost:3000"
AUTH_ALLOWED_ADDRESSES="0xYourWalletAddress"

# Backend (if not on default port)
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"

# Contract addresses (Base Sepolia — adjust for your deployment)
NEXT_PUBLIC_PRAXIS_REGISTRY_ADDRESS="0x..."
NEXT_PUBLIC_VAULT_USDC_ADDRESS="0x..."
NEXT_PUBLIC_VAULT_MORPHO_VAULT_ADDRESS="0x..."
NEXT_PUBLIC_CPF_TREASURY_ADDRESS="0x..."
NEXT_PUBLIC_CTF_CONTRACT_ADDRESS="0x..."
NEXT_PUBLIC_TWO_POOL_DEFAULT_CURVE="0x..."